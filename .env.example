# ----------------------------------------------------------------------------
# Web (apps/web) — only NEXT_PUBLIC_* values are exposed to the browser
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Venuz
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ----------------------------------------------------------------------------
# API (apps/api) — server-side only
# ----------------------------------------------------------------------------
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=America/New_York

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_URL=

# Alpaca Paper only. Never put live credentials here.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_PAPER=true

# SEC requires a descriptive User-Agent with contact information.
SEC_USER_AGENT=Venuz/0.1 contact@example.com

# Scarce provider: analyst estimates/revisions only.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_REQUEST_BUDGET=25

# LLMs: Gemini primary, OpenRouter fallback.
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Safety switches. These defaults must remain safe.
TRADING_MODE=paper
AUTO_EXECUTION_ENABLED=false
HUMAN_APPROVAL_ENABLED=true
MAX_POSITION_PCT=0.10
MIN_CASH_PCT=0.20
MAX_SECTOR_PCT=0.20
MAX_COMPANIES_PER_SECTOR=2
